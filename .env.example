# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used in emails and OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:4480

# Zoho Books — leave ZOHO_MODE=mock until credentials are configured
ZOHO_MODE=mock
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ORGANIZATION_ID=
# Data centre: in | com | eu | com.au | jp | ca | sa
ZOHO_REGION=in

# Email (Resend). Leave blank to disable outbound email; in-app notifications still work.
RESEND_API_KEY=
EMAIL_FROM="Fermier Agency <no-reply@example.com>"

# Shared secret for the integration job runner endpoint (Vercel Cron)
CRON_SECRET=change-me
